PORT=3004
DB_URL=mongodb://localhost:27017/score
MONGO_URI=mongodb://localhost:27017/score

# Internal authentication between services
SCORE_SERVICE_API_KEY=internal-score-key

# AI provider: imagga | google-vision
AI_SERVICE=imagga
AI_REQUEST_TIMEOUT_MS=5000

# Imagga credentials
IMAGGA_API_KEY=your_imagga_api_key
IMAGGA_API_SECRET=your_imagga_api_secret

# Google Vision key (optional if AI_SERVICE=imagga)
GOOGLE_VISION_API_KEY=your_google_vision_api_key

# Scoring formula weights (will be normalized)
SIMILARITY_WEIGHT=0.7
TIMING_WEIGHT=0.3
